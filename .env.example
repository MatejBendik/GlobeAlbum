# Copy to .env.local. Never commit credentials. Node 24 is required.
# Pooled runtime connection; DIRECT_URL is only for reviewed migrations.
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Worker uses a private R2 binding; no account-wide S3 key is needed in Next.js.
IMAGE_WORKER_URL=
IMAGE_WORKER_SECRET=
CRON_SECRET=
GEONAMES_USERNAME=
