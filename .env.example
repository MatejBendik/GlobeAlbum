# Copy to .env.local. Never commit credentials. Node 24 is required.
# Pooled runtime connection; DIRECT_URL is only for reviewed migrations.
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMAGE_WORKER_URL=
IMAGE_WORKER_SECRET=
CRON_SECRET=
GEONAMES_USERNAME=
# Explicit opt-in, local development only. Never supported in production.
DEMO_MODE=false
