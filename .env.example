# Copy to .env.local. Never commit credentials. Node 24 is required.
# neon deploy pulls these service variables. Runtime uses the pooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Generate locally (32+ characters); never expose to browser code.
NEON_AUTH_COOKIE_SECRET=
# Server-only project-scoped Neon control-plane key for confirmed identity deletion.
NEON_AUTH_ADMIN_API_KEY=
NEON_AUTH_PROJECT_ID=
NEON_AUTH_BRANCH_ID=
APP_ORIGIN=http://127.0.0.1:3000
# Optional explicit local/CI migration override only. Normally leave unset.
# DIRECT_URL=
# Worker uses a private R2 binding; no account-wide S3 key is needed in Next.js.
IMAGE_WORKER_URL=
IMAGE_WORKER_SECRET=
CRON_SECRET=
GEONAMES_USERNAME=
# Google client ID is public: settings uses it for the Google Identity button.
# Neon Auth verifies its ID token using the configured provider credentials.
GOOGLE_CLIENT_ID=
# Optional local operations copy only. Never sent to the browser.
GOOGLE_CLIENT_SECRET=
